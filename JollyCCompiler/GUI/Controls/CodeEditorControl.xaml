<UserControl x:Class="JollyCCompiler.GUI.Controls.CodeEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="900" Background="#1E1E1E">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Find / Replace bar -->
        <Border x:Name="SearchBar" Grid.Row="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,0,1" Padding="8" Visibility="Collapsed">
            <StackPanel>

                <!-- Find row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox" Grid.Column="0" Height="28" Padding="7,2" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#5A5A5A" BorderThickness="1" FontFamily="Cascadia Mono" FontSize="13" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown"/>
                    <Button Grid.Column="1" Width="30" Height="28" Margin="6,0,0,0" Content="▲" ToolTip="Previous match" Click="PreviousMatchButton_Click"/>
                    <Button Grid.Column="2" Width="30" Height="28" Margin="2,0,0,0" Content="▼" ToolTip="Next match" Click="NextMatchButton_Click"/>
                    <TextBlock x:Name="MatchCountText" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#858585" FontSize="12"/>
                    <Border Grid.Column="4"/>
                    <Button Grid.Column="5" Width="28" Height="28" Content="✕" ToolTip="Close search" Click="CloseSearchButton_Click"/>
                </Grid>

                <!-- Replace row -->
                <Grid x:Name="ReplaceRow" Margin="0,6,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ReplaceTextBox" Grid.Column="0" Height="28" Padding="7,2" VerticalContentAlignment="Center" Background="#1E1E1E" Foreground="#D4D4D4" BorderBrush="#5A5A5A" BorderThickness="1" FontFamily="Cascadia Mono" FontSize="13" KeyDown="ReplaceTextBox_KeyDown"/>
                    <Button Grid.Column="1" Height="28" Margin="6,0,0,0" Padding="10,0" Content="Replace" Click="ReplaceButton_Click"/>
                    <Button Grid.Column="2" Height="28" Margin="4,0,0,0" Padding="10,0" Content="Replace All" Click="ReplaceAllButton_Click"/>
                    <TextBlock Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#858585" FontSize="12" Text="Ctrl+H"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Line numbers -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="Green" BorderThickness="0,0,3,0">
                <ScrollViewer x:Name="LineNumberScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" Focusable="False" IsHitTestVisible="False" CanContentScroll="False">
                    <TextBlock x:Name="LineNumbers" Margin="0,4,8,4" HorizontalAlignment="Right" FontFamily="Cascadia Mono" FontSize="14" Foreground="#858585" TextAlignment="Right"/>
                </ScrollViewer>
            </Border>

            <!-- Code editor -->
            <RichTextBox x:Name="EditorTextBox" Grid.Column="1" AcceptsTab="True" AcceptsReturn="True" AutoWordSelection="False" Background="#1E1E1E" Foreground="#D4D4D4" BorderThickness="0" CaretBrush="#FFFFFF" FontFamily="Cascadia Mono" FontSize="14" Padding="8,4,20,4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" TextChanged="EditorTextBox_TextChanged" SelectionChanged="EditorTextBox_SelectionChanged" PreviewKeyDown="EditorTextBox_PreviewKeyDown" PreviewMouseWheel="EditorTextBox_PreviewMouseWheel"/>
        </Grid> 
    </Grid>
</UserControl>
