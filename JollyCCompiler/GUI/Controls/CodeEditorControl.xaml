<UserControl x:Class="JollyCCompiler.GUI.Controls.CodeEditorControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Background="#151D27">
    <Grid Background="#151D27">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="SearchBar" Grid.Row="0" Visibility="Collapsed" Background="#243242" Padding="8" BorderBrush="#405166" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBox x:Name="SearchTextBox" Width="260" Height="28" Padding="7,0" VerticalContentAlignment="Center" Background="#19232F" Foreground="#E6EDF5" TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown"/>
                    <Button Content="↑" Width="30" Margin="6,0,0,0" Click="PreviousMatchButton_Click"/>
                    <Button Content="↓" Width="30" Margin="2,0,0,0" Click="NextMatchButton_Click"/>
                    <TextBlock x:Name="MatchCountText" Margin="8,0" VerticalAlignment="Center" Foreground="#B4C3D3"/>
                    <CheckBox x:Name="MatchCaseCheckBox" Content="Match case" Foreground="#E6EDF5" VerticalAlignment="Center" Margin="10,0" Checked="SearchOptionChanged" Unchecked="SearchOptionChanged"/>
                    <CheckBox x:Name="WholeWordCheckBox" Content="Whole word" Foreground="#E6EDF5" VerticalAlignment="Center" Margin="10,0" Checked="SearchOptionChanged" Unchecked="SearchOptionChanged"/>
                    <Button Content="✕" Width="30" Click="CloseSearchButton_Click"/>
                </DockPanel>
                <DockPanel x:Name="ReplaceRow" Visibility="Collapsed" Margin="0,6,0,0" LastChildFill="False">
                    <TextBox x:Name="ReplaceTextBox" Width="260" Height="28" Padding="7,0" VerticalContentAlignment="Center" Background="#19232F" Foreground="#E6EDF5"/>
                    <Button Content="Replace" Margin="6,0,0,0" Padding="10,0" Click="ReplaceButton_Click"/>
                    <Button Content="Replace All" Margin="4,0,0,0" Padding="10,0" Click="ReplaceAllButton_Click"/>
                </DockPanel>
            </StackPanel>
        </Border>
        <avalon:TextEditor x:Name="EditorTextBox" Grid.Row="1" Background="#151D27" Foreground="#E6EDF5" FontFamily="Consolas" FontSize="14" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="False" TextChanged="EditorTextBox_TextChanged" PreviewKeyDown="EditorTextBox_PreviewKeyDown"/>
    </Grid>
</UserControl>
